# Streamlit Community Cloud secrets template.
# Copy this into the app's "Secrets" box in Streamlit Community Cloud settings
# (Settings -> Secrets) - do NOT commit a filled-in copy of this file to git.

[snowflake]
account   = "NX75692"
user      = "BORROWER360_DEMO_USER"
password  = "REPLACE_WITH_DEMO_USER_PASSWORD"
role      = "BORROWER360_DEMO_ROLE"
warehouse = "COMPUTE_WH"
database  = "BORROWER360"
schema    = "CURATED"
# Personal Access Token for BORROWER360_DEMO_USER, used for the Cortex Analyst
# REST call in the "Ask" tab. Generate with:
#   ALTER USER BORROWER360_DEMO_USER ADD PROGRAMMATIC ACCESS TOKEN demo_pat;
pat = "REPLACE_WITH_PAT"
